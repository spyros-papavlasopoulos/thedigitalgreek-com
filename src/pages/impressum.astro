---
import Base from "../layouts/Base.astro";
import Email from "../components/Email.astro";
// Demo content: replace every [placeholder] with real details before going live.
---

<Base
  title="Impressum"
  description="Impressum (legal notice) of The Digital Greek, Berlin."
>
  <article lang="de" class="wrap grid grid-cols-12 gap-x-6 pt-16 md:pt-24">
    <div class="col-span-12 md:col-span-4">
      <h1 class="text-title">Impressum</h1>
      <p class="mt-4 font-mono text-meta text-muted">Angaben gemäß § 5 DDG</p>
    </div>

    <div
      class="col-span-12 mt-12 grid gap-10 md:col-span-7 md:col-start-6 md:mt-0"
    >
      <section>
        <h2 class="font-mono text-meta text-muted">Anbieter</h2>
        <p class="mt-2">
          Spyros Papavlasopoulos<br />
          The Digital Greek<br />
          Kastanienallee<br />
          10435 Berlin<br />
          Deutschland
        </p>
      </section>

      <section>
        <h2 class="font-mono text-meta text-muted">Kontakt</h2>
        <p class="mt-2">
          E-Mail: <Email class="border-b border-current" />
        </p>
      </section>

      <section>
        <h2 class="font-mono text-meta text-muted">Haftung für Links</h2>
        <p class="mt-2">
          Diese Website enthält Links zu externen Websites Dritter, auf deren
          Inhalte ich keinen Einfluss habe. Für diese fremden Inhalte ist stets
          der jeweilige Anbieter oder Betreiber der Seiten verantwortlich. Bei
          Bekanntwerden von Rechtsverletzungen werde ich derartige Links
          umgehend entfernen.
        </p>
      </section>
    </div>
  </article>
</Base>
