---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import Email from "../components/Email.astro";
import { getImage } from "astro:assets";
// Same files global.css loads via @fontsource; preloaded so text renders in Geist from the first paint
import geist from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import { person, team, core } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string; // absolute URL or site path for og:image
  imageAlt?: string;
  schema?: object[]; // extra JSON-LD nodes for this page
}
const {
  title,
  description = `Berlin-based digital agency using open-source software, smart strategy and clean design to build fast, SEO-optimized websites and apps. Since ${person.since}.`,
  image = "/og.png",
  imageAlt = "The Digital Greek logo",
  schema = [],
} = Astro.props;

const fullTitle = title
  ? `${title} · The Digital Greek`
  : "The Digital Greek · Web agency in Berlin";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Structured data shared by every page: the agency, its people and the site.
const site = Astro.site!.href;
const people = await Promise.all(
  team.map(async (m) => ({
    "@type": "Person",
    name: m.name,
    jobTitle: m.role,
    image: new URL((await getImage({ src: m.photo, width: 400 })).src, site)
      .href,
    ...(m.sameAs && { sameAs: m.sameAs }),
  })),
);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${site}#org`,
      name: "The Digital Greek",
      url: site,
      logo: new URL("/og.png", site).href,
      image: new URL("/og.png", site).href,
      description:
        "Berlin-based digital agency building fast, SEO-optimized websites and apps with open-source software.",
      foundingDate: String(person.since),
      address: {
        "@type": "PostalAddress",
        addressLocality: "Berlin",
        addressCountry: "DE",
      },
      areaServed: "DE",
      knowsAbout: [
        ...core,
        "Web performance",
        "Core Web Vitals",
        "Accessibility",
        "Structured data",
      ],
      employee: people,
    },
    {
      "@type": "WebSite",
      "@id": `${site}#website`,
      url: site,
      name: "The Digital Greek",
      inLanguage: "en",
      publisher: { "@id": `${site}#org` },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#121112" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content="The Digital Greek" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark")
          document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="sea" aria-hidden="true">
      <div class="sea-dots"></div>
      <div class="swell"><div class="sea-dots"></div></div>
      <div class="swell swell-b"><div class="sea-dots"></div></div>
    </div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-10 focus:bg-bg focus:p-2"
      >Skip to content</a
    >

    <header class="wrap flex items-start justify-between py-8">
      <a href="/" aria-label="The Digital Greek, home" class="hover:text-fg">
        <Logo class="block h-9 w-auto md:h-12" />
      </a>
      <nav class="flex gap-6" aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="wrap mt-32 border-t border-line pt-24 pb-8">
      <Logo class="block h-auto w-full" decorative />
      <div
        class="mt-8 flex flex-wrap justify-between gap-4 font-mono text-meta text-muted"
      >
        <span
          >© {new Date().getFullYear()} The Digital Greek · Berlin ·{" "}
          <a href="/impressum" class="hover:text-accent">Impressum</a> ·{" "}
          <button
            type="button"
            class="cursor-pointer hover:text-accent"
            data-consent-open>Cookies</button
          ></span
        >
        <Email />
        <button
          type="button"
          class="cursor-pointer hover:text-accent"
          data-theme-toggle
        >
          Theme: <span data-theme-label>auto</span>
        </button>
      </div>
    </footer>

    <script is:inline>
      document.querySelectorAll("[data-email]").forEach((a) => {
        const e = [...atob(a.dataset.email)].reverse().join("");
        a.href = "mailto:" + e;
        a.textContent = e;
      });
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const label = document.querySelector("[data-theme-label]");
        const current = () =>
          root.dataset.theme ||
          (matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark");
        label.textContent = current();
        document
          .querySelector("[data-theme-toggle]")
          .addEventListener("click", () => {
            const next = current() === "dark" ? "light" : "dark";
            root.dataset.theme = next;
            label.textContent = next;
            try {
              localStorage.setItem("theme", next);
            } catch (e) {}
          });
      })();
    </script>

    <!-- Consent banner: Google Analytics loads only after "Accept" (§25 TDDDG) -->
    <div
      data-consent
      hidden
      role="dialog"
      aria-label="Analytics consent"
      class="fixed inset-x-4 bottom-4 z-20 border border-line bg-bg p-4 font-mono text-meta md:right-8 md:left-auto md:max-w-sm"
    >
      <p>
        May I use Google Analytics to count visits? It sets cookies and sends
        data to Google. You can change your mind any time via "Cookies" in the
        footer.
      </p>
      <div class="mt-4 flex gap-3">
        <button
          type="button"
          data-consent-choice="yes"
          class="cursor-pointer border border-current px-3 py-1 hover:text-accent"
          >Accept</button
        >
        <button
          type="button"
          data-consent-choice="no"
          class="cursor-pointer border border-current px-3 py-1 hover:text-accent"
          >Reject</button
        >
      </div>
    </div>
    <script is:inline>
      (() => {
        const ID = "G-95RNTJK204";
        const KEY = "analytics-consent";
        const banner = document.querySelector("[data-consent]");
        let loaded = false;

        const load = () => {
          if (loaded) return;
          loaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            dataLayer.push(arguments);
          };
          gtag("js", new Date());
          gtag("config", ID);
          const s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + ID;
          document.head.appendChild(s);
        };

        // GA sets its cookies on the root domain, so try both host forms.
        const clear = () => {
          const host = location.hostname.replace(/^www\./, "");
          document.cookie.split(";").forEach((c) => {
            const name = c.split("=")[0].trim();
            if (!name.startsWith("_ga")) return;
            for (const d of ["", "; domain=" + host, "; domain=." + host])
              document.cookie = name + "=; max-age=0; path=/" + d;
          });
        };

        let choice = null;
        try {
          choice = localStorage.getItem(KEY);
        } catch (e) {}
        if (choice === "yes") load();
        else {
          // Also catches cookies GA rewrote while unloading after a withdrawal.
          clear();
          if (choice !== "no") banner.hidden = false;
        }

        banner.addEventListener("click", (e) => {
          const b = e.target.closest("[data-consent-choice]");
          if (!b) return;
          const v = b.dataset.consentChoice;
          try {
            localStorage.setItem(KEY, v);
          } catch (e) {}
          banner.hidden = true;
          if (v === "yes") return load();
          clear();
          // A running GA tag would set its cookies again, so reload without it.
          if (loaded) location.reload();
        });

        document
          .querySelector("[data-consent-open]")
          .addEventListener("click", () => (banner.hidden = false));
      })();
    </script>
  </body>
</html>
